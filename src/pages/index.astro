---
import '../styles/global.css';
import { businessConfig as c } from '../config';
const services = [
  { title: 'New HVAC Installations', description: 'Professional installation of new residential HVAC systems with proper sizing and reliable performance.' },
  { title: 'HVAC Installation for Remodeling Projects', description: 'Heating and cooling installation for home additions, renovations and complete remodeling projects.' },
  { title: 'Repairs for All Types of HVAC Systems', description: 'Diagnosis and repair for different HVAC brands, models and system types.' },
  { title: 'Preventive HVAC Maintenance', description: 'Routine inspection, cleaning and maintenance to help improve efficiency and prevent unexpected breakdowns.' },
  { title: 'Air Duct Replacement', description: 'Replacement of damaged, inefficient or outdated air ducts to improve airflow and comfort.' },
  { title: '10-Year Warranty', description: 'New qualifying HVAC installations include a 10-year warranty.', note: 'Terms and manufacturer conditions may apply.' }
];
const serviceCities = ['Houston, TX','Katy, TX','Sugar Land, TX','Richmond, TX','Rosenberg, TX','Cypress, TX','Pearland, TX','Missouri City, TX','Fulshear, TX','The Woodlands, TX'];
const year = new Date().getFullYear();
const base = `${import.meta.env.BASE_URL}/`;
---
<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width"><meta name="description" content="Fast, reliable heating and air conditioning service available 24 hours."><title>{c.name} | {c.tagline}</title></head>
<body>
  <header class="site-header"><div class="header-inner wrap"><a class="header-logo" href="#top" aria-label="Mario HVAC home"><img src={`${base}images/mario-hvac-logo.png`} alt="Mario HVAC Houston Texas"></a><a class="top-phone" href={`tel:${c.phoneHref}`}>Call Now: <strong>{c.phoneDisplay}</strong> <span>☎</span></a></div><div class="trust-strip">Your Trusted HVAC Experts - Fast, Reliable &amp; Available 24 Hours.</div></header>
  <main id="top">
    <section class="hero"><div class="hero-copy"><div class="hero-copy-inner"><img class="hero-brand-logo" src={`${base}images/mario-hvac-logo.png`} alt="Mario HVAC Houston Texas"><h1>Professional Heating &amp; Cooling Services</h1><p><b>Fast, Same-Day Service, Repair &amp; Installation.</b></p><p>Call Now To Schedule Service Today:</p><a class="call-btn hero-btn" href={`tel:${c.phoneHref}`}>Call Now: {c.phoneDisplay}</a><div class="brand-logos" aria-label="Major brands serviced"><img src={`${base}images/brands/carrier.png`} alt="Carrier HVAC"><img src={`${base}images/brands/trane.png`} alt="Trane HVAC"><img src={`${base}images/brands/daikin.png`} alt="Daikin HVAC"><img src={`${base}images/brands/goodman.png`} alt="Goodman Air Conditioning"><img src={`${base}images/brands/lennox.png`} alt="Lennox HVAC"></div><small>Don't See Your Brand? Call Us!</small><div class="stars" aria-label="5 out of 5 stars">★ ★ ★ ★ ★</div><b class="homes">Trusted by 36,800+ Homes Since 2021</b></div></div><div class="hero-image"><img src={`${base}images/hero-technician.png`} alt="HVAC technician inspecting a wall-mounted air conditioner"></div></section>
    <section class="benefits"><div class="wrap benefit-grid"><div><i>24</i><b>24-7 Service</b></div><div><i>✓</i><b>Up-Front Estimates</b></div><div><i>✹</i><b>Locally Trusted</b></div></div></section>
    <section class="section white"><div class="wrap services-wrap"><div class="services-intro"><h2 class="underlined">HVAC Services</h2><p>Professional heating and cooling solutions for installations, remodeling projects, repairs and ongoing system care.</p></div><ul class="service-list service-details">{services.map((service)=><li><strong>{service.title}</strong><span>{service.description}</span>{service.note && <small>{service.note}</small>}</li>)}</ul></div></section>
    <section class="section white compact-top"><div class="wrap split"><div class="photo-cta"><img src={`${base}images/indoor-repair.png`} alt="Technician repairing an indoor HVAC unit"><h3>Call Now For Same Day Service:</h3><a class="call-btn" href={`tel:${c.phoneHref}`}>☎ &nbsp; Call Now: {c.phoneDisplay}</a></div><div class="adv"><h2>Save Time With {c.name}</h2><div class="adv-item"><b>Reliable 24 Hour Service:</b> Whether you need service now or want to request a free estimate, our network of technicians ensures we have someone available to help 24 hours a day.</div><div class="adv-item"><b>No-Obligation Estimates:</b> Call us any time to ask our project specialists questions or to request an up-front quote for a job you're considering.</div><div class="adv-item"><b>Fast Service:</b> When you call us and enter your zip code we're able to send one of our experts who is nearby and available to help now.</div><p><b>Need service today?</b> Our skilled professionals are on standby ready to assist. Call us at <a class="red-link" href={`tel:${c.phoneHref}`}>{c.phoneDisplay}</a> to connect with an expert who can help solve your problem today.</p></div></div></section>
    <section class="section steps"><div class="wrap split"><div><h2>Get Service Today In 3 Easy Steps</h2><ol class="step-list"><li><b>Call Our 24 Hour Phone Line:</b> Our experts are available 24 hours to take your call, provide an up-front estimate and dispatch the nearest technician.</li><li><b>Our Expert Arrives:</b> Our experts will assess and diagnose the problem, answer any questions and provide an estimate.</li><li><b>Your Problem Is Fixed:</b> If you decide to proceed, our technician will perform the required work. Call us at <a class="red-link" href={`tel:${c.phoneHref}`}>{c.phoneDisplay}</a>.</li></ol><a class="call-btn" href={`tel:${c.phoneHref}`}>☎ &nbsp; Call Now: {c.phoneDisplay}</a></div><div class="trusted"><h2>Trusted By Over <em>{c.homesServed}</em> Homeowners<br>Every Year</h2><img src={`${base}images/outdoor-repair.png`} alt="Technician repairing an outdoor air conditioning unit"></div></div></section>
    <section class="section service-area"><div class="wrap"><div class="service-area-heading"><h2>Proudly Serving Houston and Surrounding Areas</h2><p>Mario HVAC provides professional heating and air conditioning services throughout the Greater Houston area.</p></div><ul class="city-grid">{serviceCities.map((city)=><li><span aria-hidden="true">●</span>{city}</li>)}</ul><div class="map-frame"><iframe src="https://www.google.com/maps?q=Houston,Texas&amp;z=10&amp;output=embed" width="100%" height="420" style="border:0;" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Mario HVAC service area around Houston, Texas"></iframe></div></div></section>
  </main>
  <footer><div class="wrap footer-top"><div><a class="footer-logo" href="#top" aria-label="Mario HVAC home"><img src={`${base}images/mario-hvac-logo.png`} alt="Mario HVAC Houston Texas"></a><h3>24-Hour Service</h3></div><div><h3>Call Now For Same Day Service</h3><a href={`tel:${c.phoneHref}`}>{c.phoneDisplay}</a></div></div><div class="legal wrap"><h4>IMPORTANT INFORMATION</h4><p>Mario HVAC provides residential heating, ventilation and air conditioning services in Houston, Texas and surrounding communities. Service availability, pricing, warranties and completion times may vary depending on the equipment, property conditions and scope of work. Estimates are subject to an on-site inspection. Manufacturer warranty terms and conditions may apply.</p><p class="legal-secondary">Customers are encouraged to review and approve the written estimate before work begins. Emergency and same-day service are subject to technician availability.</p><div class="footer-links"><a href="#">Privacy Policy</a> &amp; <a href="#">Terms</a></div><p>© {year} {c.name}. All Rights Reserved.</p></div></footer>
  <button id="requestOpen" class="floating" aria-haspopup="dialog">✉ <span>Request Service</span></button>
  <div id="overlay" class="overlay" hidden><aside class="drawer" role="dialog" aria-modal="true" aria-labelledby="formTitle"><button id="requestClose" class="close" aria-label="Close form">×</button><h2 id="formTitle">Request Service</h2><p>Tell us how we can help. We'll contact you shortly.</p><form id="serviceForm" novalidate><label>Full Name<input name="name" autocomplete="name" required></label><label>Phone Number<input name="phone" type="tel" autocomplete="tel" required pattern="[0-9()+ -.]{7,}"></label><label>Email Address<input name="email" type="email" autocomplete="email" required></label><label>Service Type<select id="serviceType" name="serviceType" required><option value="" selected disabled>Choose a service</option><option value="new-installation">New HVAC System Installation</option><option value="remodeling-installation">HVAC Installation for Remodeling</option><option value="hvac-repair">HVAC System Repair</option><option value="preventive-maintenance">Preventive Maintenance</option><option value="duct-replacement">Air Duct Replacement</option><option value="warranty-request">Warranty Request</option><option value="other">Other Service</option></select></label><label>ZIP Code<input name="zip" inputmode="numeric" autocomplete="postal-code" required pattern="[0-9]{5}"></label><label>Message<textarea name="message" rows="4" required></textarea></label><label class="check"><input name="urgent" type="checkbox"> I need urgent service</label><label class="check"><input name="privacy" type="checkbox" required> I accept the privacy policy</label><div id="formMessage" class="form-message" aria-live="polite"></div><button class="call-btn submit" type="submit">Request Service</button></form></aside></div>
  <script>
    // @ts-nocheck -- DOM elements are guaranteed by the static page markup above.
    const overlay=document.querySelector('#overlay'); const open=document.querySelector('#requestOpen'); const close=document.querySelector('#requestClose'); const form=document.querySelector('#serviceForm'); const msg=document.querySelector('#formMessage'); let lastFocus;
    const show=()=>{lastFocus=document.activeElement; overlay.hidden=false; document.body.classList.add('locked'); setTimeout(()=>overlay.classList.add('shown'),10); close.focus()};
    const hide=()=>{overlay.classList.remove('shown'); document.body.classList.remove('locked'); setTimeout(()=>overlay.hidden=true,220); lastFocus?.focus()};
    open.addEventListener('click',show); close.addEventListener('click',hide); overlay.addEventListener('click',e=>{if(e.target===overlay)hide()}); document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!overlay.hidden)hide(); if(e.key==='Tab'&&!overlay.hidden){const f=[...overlay.querySelectorAll('button,input,select,textarea')]; const first=f[0],last=f[f.length-1]; if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus()}else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus()}}});
    async function submitServiceRequest(formData){/* Replace this delay with the real API endpoint. */ await new Promise(r=>setTimeout(r,900)); return Object.fromEntries(formData)}
    form.addEventListener('submit',async e=>{e.preventDefault(); msg.textContent=''; if(!form.checkValidity()){form.reportValidity();msg.textContent='Please complete all required fields.';return} const btn=form.querySelector('.submit'); btn.disabled=true;btn.textContent='Sending…'; try{await submitServiceRequest(new FormData(form));form.reset();msg.textContent='Thank you! Your request was sent successfully.';msg.classList.add('success')}finally{btn.disabled=false;btn.textContent='Request Service'}});
  </script>
</body></html>
